# Copy to .env and replace every CHANGE_ME value before starting the stack.
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_24
POSTGRES_DB=sub2api
REDIS_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_24
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
TOTP_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
ADMIN_EMAIL=admin@sub2api.local
ADMIN_PASSWORD=CHANGE_ME_USE_A_STRONG_ADMIN_PASSWORD

# This downstream deployment intentionally accepts HTTP/private upstream URLs.
# It reduces URL allowlist/SSRF protection; use strict when compatibility is not required.
SECURITY_URL_POLICY_PROFILE=compatible

TZ=Asia/Shanghai
SUB2API_ORIGIN_PORT=18080
SUB2API_IMAGE_TAG=local
SUB2API_VERSION=0.1.183-zifeiyu
SUB2API_COMMIT=local

# Default when this Compose file stays in deploy/zifeiyu.
# If copied beside an app/ checkout on the server, set this to ./app.
SUB2API_BUILD_CONTEXT=../..
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
GOPROXY=https://goproxy.cn,direct
GOSUMDB=sum.golang.google.cn
